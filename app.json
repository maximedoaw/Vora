{
  "expo": {
    "name": "vora",
    "slug": "vora",
    "owner": "maximedoaw",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vora",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.vora.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Vora a besoin de ta position pour te placer sur la carte et calculer un itinéraire."
      }
    },
    "android": {
      "package": "com.vora.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "@clerk/expo",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Vora a besoin de ta position pour te placer sur la carte et calculer un itinéraire."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1ED760",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "b28b3793-a820-4aba-923d-e448805eda2b"
      }
    }
  }
}
